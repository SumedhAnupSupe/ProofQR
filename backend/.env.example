PORT=4000
# Production (Neon/Railway): set this to your Postgres connection string.
# Leave unset for local dev -> uses a JSON file store (data/presence.json).
DATABASE_URL=postgres://user:password@host:5432/presence
# TLS/SSL. Neon requires SSL. Local docker-compose sets this to false.
DATABASE_SSL=true
DATABASE_FILE=./data/presence.json
JWT_SECRET=change-me-to-a-long-random-secret
TOKEN_VALIDITY_SECONDS=20
VERIFICATION_SESSION_TTL_SECONDS=60
FRAME_DURATION_MS=500
CORS_ORIGIN=*
ADMIN_API_KEY=change-me-admin-key
